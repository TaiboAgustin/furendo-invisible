# Copiá este archivo como .dev.vars para desarrollo local. No se sube al repo.
# En producción se cargan con `npx wrangler secret put NOMBRE`.

# Contraseña para entrar al panel del organizador.
ADMIN_PASSWORD=cambiame

# Texto largo y al azar para firmar la sesión. Generalo con:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=reemplazar-por-un-texto-largo-al-azar

# --- Discord (para avisar por mensaje privado) ---
# Token del bot: Developer Portal → tu aplicación → Bot → Reset Token.
# DISCORD_BOT_TOKEN=
# Id del server: en Discord, activá el modo desarrollador y hacé clic derecho en el server → Copiar ID.
# DISCORD_GUILD_ID=

# Opcional: canal donde se publica la ronda completa el día de la revelación.
# DISCORD_REVEAL_CHANNEL_ID=

# --- Mail de respaldo (para quien no tiene Discord) ---
# API key de Brevo: brevo.com → SMTP y API → API keys.
# BREVO_API_KEY=
# Remitente verificado en Brevo.
# MAIL_FROM=
# MAIL_FROM_NAME=Furendo Invisible
