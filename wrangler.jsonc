{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "furendo-invisible",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "furendo-invisible",
      // En local cualquier valor sirve. Al publicar se reemplaza por el id que da
      // `wrangler d1 create furendo-invisible`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
