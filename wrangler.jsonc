{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "furendo-invisible",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  // Workers AI: reescribe en tono neutro los mensajes de quien regala.
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Clave pública de la aplicación de Discord (Developer Portal → General Information).
    // No es secreta: sirve para comprobar que los comandos vienen de Discord.
    "DISCORD_PUBLIC_KEY": "5854ff3c94c3dbc0d899faddd4962cd64c8b99ac57359a956d073b50844abbb5"
  },
  // Cada hora (minuto 5): revela los eventos cuya fecha llegó y sigue con los avisos pendientes.
  // 03:05 UTC son las 00:05 en Argentina.
  "triggers": {
    "crons": ["5 * * * *"]
  },
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "furendo-invisible",
      // Id de la base en Cloudflare (`wrangler d1 create furendo-invisible`).
      // Si armás tu propia copia, creá tu base y reemplazalo por el tuyo.
      "database_id": "c0d25f72-dc25-4253-ae1b-a7f0066220b3",
      "migrations_dir": "migrations"
    }
  ]
}
